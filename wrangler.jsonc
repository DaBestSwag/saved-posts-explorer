{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saved-posts-explorer",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/hf/*"]
  }
}
